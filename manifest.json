{
  "manifest_version": 3,
  "name": "Crimson Desert Companion",
  "version": "1.0.20",
  "description": "Shows your real-time player position on the MapGenie map",
  "browser_specific_settings": {
    "gecko": {
      "id": "cd-map-companion-2026@leandro",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["*://mapgenie.io/*", "*://*.mapgenie.io/*"],
  "content_scripts": [
    {
      "matches": ["*://mapgenie.io/*", "*://*.mapgenie.io/*"],
      "js": ["bridge.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://mapgenie.io/*", "*://*.mapgenie.io/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "world": "MAIN",
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crimson Desert Companion"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
